{
  "name": "community-detectives",
  "version": "0.1.0",
  "private": true,
  "description": "Interaktive Krimi- und Ermittlungsplattform für Twitch-Streamer und ihre Communities",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,gray \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "cases:validate": "tsx scripts/validate-cases.ts",
    "cases:import": "tsx scripts/import-cases.ts",
    "admin": "tsx scripts/admin.ts",
    "setup": "prisma generate && prisma migrate deploy && npm run cases:import"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "ws": "8.22.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
