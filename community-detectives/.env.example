# ------------------------------------------------------------
# COMMUNITY DETECTIVES – Konfiguration (kopieren nach .env)
# ------------------------------------------------------------

# PostgreSQL-Verbindung
DATABASE_URL=postgresql://detectives:detectives@localhost:5432/community_detectives

# Port des Node-Servers und öffentliche Adresse der App.
# Entwicklung: Vite läuft auf 5173 und leitet /api + /socket.io an 8787 weiter.
PORT=8787
PUBLIC_URL=http://localhost:5173

# Pflicht in Produktion (lange Zufallswerte, z. B. `openssl rand -base64 48`)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Twitch-Anwendung (https://dev.twitch.tv/console/apps)
# OAuth Redirect URL in der Twitch-Konsole: <PUBLIC_URL>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Twitch-Endpunkte überschreiben (nur für Tests/Mocks)
# TWITCH_AUTH_BASE=https://id.twitch.tv
# TWITCH_API_BASE=https://api.twitch.tv/helix
# TWITCH_EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws

# Lokaler Entwicklungs-Login ohne Twitch (außerhalb von Produktion automatisch aktiv,
# solange keine Twitch-Zugangsdaten gesetzt sind)
# ALLOW_DEV_LOGIN=true
# Chat-Simulator im Kontrollzentrum (außerhalb von Produktion automatisch aktiv)
# ENABLE_CHAT_SIMULATOR=true

# Twitch-Logins mit Zugriff auf die Fallverwaltung (kommagetrennt)
ADMIN_LOGINS=

# Plan für neue Streamer: free | creator | premium
DEFAULT_PLAN=free

# Hinter einem Reverse Proxy (nginx, Caddy …) auf true setzen
TRUST_PROXY=false
